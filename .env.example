# Copy to .env (never commit .env).
# Public domain name pointing at the server; "localhost" for a local test.
DOMAIN=localhost
# Long random secret for /api/admin/*. Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
KEYSTROKEID_ADMIN_KEY=change-me
KEYSTROKEID_MAX_SESSIONS=10
KEYSTROKEID_BACKUP_KEEP=14
